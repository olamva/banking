{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.sh\"",
            "statusMessage": "Checking the checkout"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh stack:*)",
      "Bash(git worktree:*)",
      "Bash(git -C rules add:*)",
      "Bash(git -C rules commit:*)",
      "Bash(git -C rules status:*)",
      "Bash(git -C rules diff:*)",
      "Bash(git -C rules log:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm worktree:link:*)",
      "Bash(pnpm worktree:cleanup:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(gh stack merge:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)"
    ]
  }
}
