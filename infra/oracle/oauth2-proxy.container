[Unit]
Wants=network-online.target
After=network-online.target

[Container]
Image=quay.io/oauth2-proxy/oauth2-proxy:v7.15.5
Network=host
EnvironmentFile=/etc/banking/oauth2-proxy.env
Volume=/etc/banking/oauth2-proxy.cfg:/etc/banking/oauth2-proxy.cfg:ro
Volume=/etc/banking/emails:/etc/banking/emails:ro
Exec=--config=/etc/banking/oauth2-proxy.cfg

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
