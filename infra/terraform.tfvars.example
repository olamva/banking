# Copy to infra/terraform.tfvars and fill it in. The gitignore refuses *.tfvars,
# because every value below is a secret or an address. infra/oracle/configure.sh
# and infra/seed-token.sh read it.

# A classic GitHub token with only the read:packages scope. The VM pulls its
# image from ghcr.io with it.
ghcr_token = ""

# An empty list denies everybody.
allowed_emails = ["you@example.com"]

# The host name that serves the dashboard. Point its A record at the VM.
custom_domain = ""

# Google Cloud console, OAuth client, type "Web application". Add
# https://<custom_domain>/oauth2/callback to its redirect URIs.
google_client_id     = "....apps.googleusercontent.com"
google_client_secret = ""

# The SECOND SB1 client, not the one the Mac uses. The refresh token rotates on
# every exchange, so two processes on one chain invalidate each other.
#
# These four may stay empty through the first configure.sh run. The portal wants
# a redirect before it issues a client, and the site serves the page without
# them. The BankID login runs on the Mac, so the redirect is a localhost URL. Use
# a port that the first client does not use.
sb1_client_id             = ""
sb1_client_secret         = ""
sb1_redirect_uri          = "http://localhost:12346/callback"
sb1_financial_institution = ""
