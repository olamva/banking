# Copy to infra/terraform.tfvars and fill it in. The gitignore refuses *.tfvars,
# because every value below is a secret or an address. The state does not sit
# beside it: infra/bootstrap.sh puts that in Azure.

subscription_id = "00000000-0000-0000-0000-000000000000"

# A classic GitHub token with only the read:packages scope. The app pulls its
# image from ghcr.io with it.
ghcr_token = ""

# An empty list denies everybody.
allowed_emails = ["you@example.com"]

# A host name of your own that serves the dashboard. Leave it empty to use the
# azurecontainerapps.io name alone. `terraform output custom_domain_dns` prints
# the CNAME and the TXT record to add first. The certificate issues only after
# both resolve, so an apply before that fails.
custom_domain = ""

# Google Cloud console, OAuth client, type "Web application". Add the redirect
# that `terraform output google_redirect_uri` prints. Add
# `custom_domain_google_redirect_uri` as well when a custom domain is set.
google_client_id     = "....apps.googleusercontent.com"
google_client_secret = ""

# The SECOND SB1 client, not the one the Mac uses. The refresh token rotates on
# every exchange, so two processes on one chain invalidate each other.
#
# These four may stay empty through the first apply. The portal wants a redirect
# before it issues a client, and the site serves the page without them. The
# BankID login runs on the Mac, so the redirect is a localhost URL. Use a port
# that the first client does not use.
sb1_client_id             = ""
sb1_client_secret         = ""
sb1_redirect_uri          = "http://localhost:12346/callback"
sb1_financial_institution = ""
