ContainerAppConsoleLogs
| where TimeGenerated > ago(30d)
| extend request = parse_json(Log)
| where request.event == "http_request"
| summarize Requests = count(),
    Allowed = countif(request.access == "allowed"),
    Denied = countif(request.access == "denied"),
    Anonymous = countif(request.access == "anonymous"),
    FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
    Paths = make_set(tostring(request.path), 30),
    StatusCodes = make_set(toint(request.status), 20)
    by UserAgent = tostring(request.userAgent), ForwardedFor = tostring(request.forwardedFor)
| extend FirstSeen = datetime_utc_to_local(FirstSeen, "Europe/Oslo"),
    LastSeen = datetime_utc_to_local(LastSeen, "Europe/Oslo")
| order by LastSeen desc
