{
  "name": "banking",
  "private": true,
  "type": "module",
  "scripts": {
    "sb1": "node --env-file=.env.local src/cli.ts",
    "dev": "vite",
    "test": "node --test 'test/**/*.test.ts'",
    "worktree:link": "main=$(dirname \"$(git rev-parse --git-common-dir)\") && ln -sfn \"$main/.env.local\" \"$main/data\" \"$main/rules\" .",
    "typecheck": "tsc --noEmit",
    "deploy:web": "pnpm dlx vercel@latest build --prod --yes && pnpm dlx vercel@latest deploy --prebuilt --prod",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@vercel/functions": "^3.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
