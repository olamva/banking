{
  "name": "banking",
  "private": true,
  "type": "module",
  "bin": {
    "banking": "src/bank.ts"
  },
  "scripts": {
    "bank": "node src/bank.ts",
    "sb1": "node --env-file=.env src/cli.ts",
    "receipts": "node --env-file=.env src/receipts.ts",
    "receipts:seed": "node --env-file=.env infra/receipts-seed.ts",
    "dev": "vite",
    "shot": "node infra/shot.ts",
    "test": "oxlint && node --test 'test/**/*.test.ts'",
    "worktree:link": "node infra/worktree-link.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "build": "vite build",
    "start": "node src/web/server.ts",
    "rules:push": "bash infra/rules-push.sh",
    "ios": "bash infra/ios.sh",
    "traffic": "bash infra/traffic.sh",
    "rules:pull": "bash infra/rules-pull.sh",
    "seed:site": "bash infra/seed-token.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "worktree:cleanup": "node infra/worktree-cleanup.ts",
    "release:check": "node infra/release-check.ts"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "oxlint": "^1.91.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "postal-mime": "4.2.0"
  }
}
